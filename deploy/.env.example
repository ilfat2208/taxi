# ---------------------------------------------------------------------------
# Настройки сервера. Скопировать в deploy/.env и заполнить.
#
#   cp deploy/.env.example deploy/.env
#
# deploy/.env в .gitignore: настоящие секреты в репозиторий не попадают.
# Секреты генерируются один раз и живут только на сервере:
#
#   openssl rand -base64 48     # JWT_SECRET (минимум 32 байта)
#   openssl rand -hex 24        # INTERNAL_API_TOKEN
#   openssl rand -base64 24     # POSTGRES_PASSWORD
# ---------------------------------------------------------------------------

# --- Домен и сертификат -----------------------------------------------------
# Домен, на который выпускается сертификат. A-запись должна уже указывать на
# сервер, иначе Let's Encrypt не сможет подтвердить владение (порты 80 и 443
# должны быть открыты наружу).
DOMAIN=orta.example.kz
ACME_EMAIL=ops@example.kz

# --- База -------------------------------------------------------------------
POSTGRES_USER=orta
POSTGRES_PASSWORD=

# --- Безопасность -----------------------------------------------------------
# Общий HS256-секрет: им шлюз подписывает токены, им же их проверяют сервисы.
# Менять нельзя без перевыпуска всех токенов. Минимум 32 байта.
JWT_SECRET=
JWT_TTL_SECONDS=3600
# Секрет служебных вызовов между сервисами (/internal/**).
INTERNAL_API_TOKEN=

# --- Поведение продукта -----------------------------------------------------
# Сколько деньги держатся перед выплатой мерчанту: 24h в проде, 0s в демо.
SETTLEMENT_HOLD_PERIOD=24h
# Демо-салоны в каталоге услуг: на проде выключено.
QTIME_DEMO_SEED=false
# Сколько часов Kafka хранит события.
KAFKA_LOG_RETENTION_HOURS=72

# --- Ресурсы -----------------------------------------------------------------
# Лимит памяти на один Java-сервис. Девять сервисов + Postgres + Kafka должны
# уложиться в память хоста: на 8 ГБ это 700m на сервис, на 4 ГБ — 420m
# (и тогда часть вертикалей лучше не поднимать, см. deploy/README.md).
SERVICE_MEM_LIMIT=700m
JAVA_OPTS=-XX:MaxRAMPercentage=55 -XX:+ExitOnOutOfMemoryError
