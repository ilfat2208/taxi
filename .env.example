# ---------------------------------------------------------------------------
# Copy to .env and adjust. docker-compose reads .env automatically.
# ---------------------------------------------------------------------------

# --- Postgres ---------------------------------------------------------------
POSTGRES_USER=taxi
POSTGRES_PASSWORD=taxi
POSTGRES_PORT=5432

# --- Kafka ------------------------------------------------------------------
KAFKA_PORT=9092
KAFKA_AUTO_CREATE_TOPICS=true

# --- Redis ------------------------------------------------------------------
REDIS_PORT=6379

# --- Service ports ----------------------------------------------------------
GATEWAY_PORT=8080
ACCOUNT_SERVICE_PORT=8081
PAYMENT_SERVICE_PORT=8082
CATALOG_SERVICE_PORT=8083
ORDER_SERVICE_PORT=8084
# taxi vertical
DRIVER_SERVICE_PORT=8085
DISPATCH_SERVICE_PORT=8087
TRIP_SERVICE_PORT=8086
QTIME_SERVICE_PORT=8088

# --- Security ---------------------------------------------------------------
# HS256 secret shared by api-gateway (issuer) and resource servers (validators).
# MUST be at least 32 bytes. Replace in any non-local environment.
JWT_SECRET=local-dev-only-secret-change-me-0123456789abcdef
JWT_TTL_SECONDS=3600

# Shared secret for service-to-service calls on /internal/ endpoints.
# Local-development stand-in for mTLS between workloads.
INTERNAL_API_TOKEN=local-internal-token-change-me

# --- Spring profile ---------------------------------------------------------
SPRING_PROFILES_ACTIVE=docker

# --- Observability ----------------------------------------------------------
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE=health,info,metrics,prometheus
